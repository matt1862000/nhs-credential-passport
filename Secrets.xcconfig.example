// Copy to Secrets.xcconfig and fill in your keys. Do not commit Secrets.xcconfig.

OPEN_ROUTE_SERVICE_API_KEY = your_openrouteservice_key_here
GRAPHHOPPER_API_KEY = your_graphhopper_key_here
EBIRD_API_KEY = your_ebird_key_here

// When using the ORS proxy (HeiGIT key on server), set ORS_BASE_URL to your proxy URL.
// Leave empty to call api.openrouteservice.org directly with OPEN_ROUTE_SERVICE_API_KEY.
ORS_BASE_URL = https://wait-well.vercel.app/api/ors

INFOPLIST_KEY_OPEN_ROUTE_SERVICE_API_KEY = $(OPEN_ROUTE_SERVICE_API_KEY)
INFOPLIST_KEY_GRAPHHOPPER_API_KEY = $(GRAPHHOPPER_API_KEY)
INFOPLIST_KEY_EBIRD_API_KEY = $(EBIRD_API_KEY)
INFOPLIST_KEY_ORS_BASE_URL = $(ORS_BASE_URL)
