# Production Caddy config (copy to /etc/caddy/Caddyfile on Oracle VM).
#
# Content-Security-Policy — mapped to DocPass features:
#   connect-src  … /api/* fetches + NHS ODS trust autosuggest (directory.spineservices.nhs.uk)
#   frame-src    … PDF/image evidence previews (blob/data) + ESR help YouTube embed
#   img-src      … certificate image previews (blob/data)
#   script/style … inline handlers in static HTML + same-origin JS (no third-party CDNs)
#   object-src   … none (we use iframe/img, not <object>)
#   form-action  … login, profile, HR forms post to docpass.co.uk only

(csp_docpass) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://directory.spineservices.nhs.uk; frame-src 'self' data: blob: https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

docpass.co.uk {
	import csp_docpass
	reverse_proxy 127.0.0.1:8000
}

www.docpass.co.uk {
	import csp_docpass
	redir https://docpass.co.uk{uri}
}
