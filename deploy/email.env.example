# SMTP (required for HR emails to send)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=DocPass <noreply@docpass.co.uk>

# Set on the production host (e.g. Raspberry Pi)
BASE_URL=https://docpass.co.uk

# Optional pilot fallback when no per-user notification email is set
# HR_EMAIL_OVERRIDE=you@nhs.net
